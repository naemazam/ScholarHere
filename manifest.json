{
  "manifest_version": 3,
  "name": "ScholarPulse Pro — Research Intelligence Terminal",
  "version": "2.0.0",
  "description": "High-density bibliometric terminal for Google Scholar: Lead h-index, Gini index, OpenAlex DOI/PDF enrichment, Scholar Comparison, and CSV/BibTeX export.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openalex.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.co.uk/citations*",
        "https://scholar.google.ca/citations*",
        "https://scholar.google.com.au/citations*",
        "https://scholar.google.co.in/citations*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}