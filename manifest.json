{
  "manifest_version": 3,
  "name": "ScholarHere — Research Intelligence for Google Scholar & ORCID",
  "short_name": "ScholarHere",
  "version": "4.5.0",
  "description": "Precision bibliometric terminal for Google Scholar & ORCID: Metric Evidence Explorer, Author Attribution Audit, Lead h-index, and OpenAlex verification.",
  "homepage_url": "https://scholarhere.vercel.app/",
  "icons": {
    "16": "SHlogo.png",
    "32": "SHlogo.png",
    "48": "SHlogo.png",
    "128": "SHlogo.png"
  },
  "action": {
    "default_icon": {
      "16": "SHlogo.png",
      "32": "SHlogo.png",
      "48": "SHlogo.png",
      "128": "SHlogo.png"
    },
    "default_title": "ScholarHere Terminal",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openalex.org/*",
    "https://pub.orcid.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["SHlogo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.co.uk/citations*",
        "https://scholar.google.ca/citations*",
        "https://scholar.google.com.au/citations*",
        "https://scholar.google.co.in/citations*",
        "https://scholar.google.com.bd/citations*",
        "https://orcid.org/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}